{
  "name": "saibo-gong",
  "productName": "SaiboGong",
  "version": "0.1.0",
  "description": "賽博宮：把台灣民俗儀式套進寫程式日常的 Windows 桌面 App",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.ts",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "rcedit": "^4.0.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "cnchar": "^3.2.6",
    "cnchar-trad": "^3.2.6",
    "lunar-javascript": "^1.7.8",
    "tesseract.js": "^7.0.0"
  },
  "author": "賽博宮",
  "build": {
    "appId": "io.github.saibogong",
    "productName": "SaiboGong",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "SaiboGong",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "賽博宮",
      "uninstallDisplayName": "賽博宮",
      "artifactName": "SaiboGong-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "scripts/after-pack.cjs",
    "publish": null
  }
}
